shell = "zsh"

[templates]
defer = "{{ hooks?.pre | nl }}{% for file in files %}zsh-defer source \"{{ file }}\"\n{% endfor %}{{ hooks?.post | nl }}"

[plugins.zsh-defer]
github = "romkatv/zsh-defer"

[plugins.zsh-vi-mode]
github = "jeffreytse/zsh-vi-mode"
apply = ["defer"]

[plugins.powerlevel10k]
github = "romkatv/powerlevel10k"

[plugins.fast-syntax-highlighting]
github = "zdharma-continuum/fast-syntax-highlighting"
apply = ["defer"]

[plugins.evalcache]
github = "mroth/evalcache"

[plugins.zsh-autosuggestions]
github = "zsh-users/zsh-autosuggestions"
apply = ["defer"]

[plugins.zsh-you-should-use]
github = "MichaelAquilina/zsh-you-should-use"
apply = ["defer"]

# Clone a github or gist source over ssh or git instead of https:
# [plugins.private]
# github = "owner/plugin"
# proto = "ssh"

# Other forges use their own key and host: gitlab.com, bitbucket.org, codeberg.org.
# [plugins.gitlab-example]
# gitlab = "owner/plugin"
#
# [plugins.bitbucket-example]
# bitbucket = "team/plugin"
#
# [plugins.codeberg-example]
# codeberg = "owner/plugin"

# Git reference examples:
# [plugins.branch-example]
# github = "owner/plugin"
# branch = "main"
#
# [plugins.tag-example]
# github = "owner/plugin"
# tag = "v1.2.3"
#
# [plugins.commit-example]
# github = "owner/plugin"
# rev = "0123456789abcdef0123456789abcdef01234567"

# Example plugin selected from a subdirectory of a repository:
# [plugins.sudo]
# github = "ohmyzsh/ohmyzsh"
# dir = "plugins/sudo"

# Clone control: depth 0 clones full history (default is a shallow depth-1
# clone), and cloneopts pass extra arguments to git clone:
# [plugins.myrepo]
# github = "owner/myrepo"
# depth = 0
# cloneopts = ["--single-branch", "--filter=blob:none"]

# Install-time build hooks run in the repository root on every lock build, before
# file selection, so generated files can be sourced:
# [plugins.fzf]
# github = "junegunn/fzf"
# build = ["make install"]
# dir = "shell"
